// Сопоставление физических имён таблиц и индексов СУБД с объектами метаданных 1С
// Методичка: docs/05-1c.md (5.1), docs/06-obsluzhivanie-diagnostika.md (6.2)
//
// Как использовать: поместить в модуль внешней обработки (или общий модуль с флагом «Сервер»)
// и вызвать на сервере, например:
//
//   ТЗ = ПлоскаяСтруктураХранения("_AccumRgT1234");   // имя таблицы или индекса из плана запроса
//   Для Каждого Стр Из ТЗ Цикл
//       Сообщить(Стр.Метаданные + " | " + Стр.Назначение + " | " + Стр.ИмяИндексаХранения + " (" + Стр.ПоляИндекса + ")");
//   КонецЦикла;
//
// Второй параметр ПолучитьСтруктуруХраненияБазыДанных(, Истина) — вернуть имена в терминах СУБД
// (в нижнем регистре для PostgreSQL, как они видны в EXPLAIN).

// Возвращает таблицу «объект метаданных — таблица хранения — индекс — поля индекса».
//
// Параметры:
//   Отбор - Строка - часть физического имени таблицы или индекса (без учёта регистра);
//                    пустая строка — вся база (долго на больших конфигурациях).
//   ОбъектыМетаданных - Массив, Неопределено - ограничить конкретными объектами,
//                    например: Новый Массив(1) с Метаданные.РегистрыНакопления.ТоварыНаСкладах.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: Метаданные, Назначение, ИмяТаблицыХранения, ИмяИндексаХранения, ПоляИндекса.
//
Функция ПлоскаяСтруктураХранения(Знач Отбор = "", ОбъектыМетаданных = Неопределено) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Метаданные",         Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Назначение",         Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИмяТаблицыХранения", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИмяИндексаХранения", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ПоляИндекса",        Новый ОписаниеТипов("Строка"));

	Отбор = НРег(СокрЛП(Отбор));
	Структура = ПолучитьСтруктуруХраненияБазыДанных(ОбъектыМетаданных, Истина);

	Для Каждого СтрокаТаблицы Из Структура Цикл

		ТаблицаПодходит = ПустаяСтрока(Отбор)
			Или СтрНайти(НРег(СтрокаТаблицы.ИмяТаблицыХранения), Отбор) > 0;

		Для Каждого СтрокаИндекса Из СтрокаТаблицы.Индексы Цикл

			ИндексПодходит = ТаблицаПодходит
				Или СтрНайти(НРег(СтрокаИндекса.ИмяИндексаХранения), Отбор) > 0;
			Если Не ИндексПодходит Тогда
				Продолжить;
			КонецЕсли;

			ИменаПолей = Новый Массив;
			Для Каждого ПолеИндекса Из СтрокаИндекса.Поля Цикл
				// ИмяПоля — имя в терминах 1С, ИмяПоляХранения — колонка СУБД
				ИменаПолей.Добавить(?(ПустаяСтрока(ПолеИндекса.ИмяПоля),
					ПолеИндекса.ИмяПоляХранения,
					ПолеИндекса.ИмяПоля + " [" + ПолеИндекса.ИмяПоляХранения + "]"));
			КонецЦикла;

			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Метаданные         = СтрокаТаблицы.Метаданные;
			НоваяСтрока.Назначение         = СтрокаТаблицы.Назначение;
			НоваяСтрока.ИмяТаблицыХранения = СтрокаТаблицы.ИмяТаблицыХранения;
			НоваяСтрока.ИмяИндексаХранения = СтрокаИндекса.ИмяИндексаХранения;
			НоваяСтрока.ПоляИндекса        = СтрСоединить(ИменаПолей, ", ");

		КонецЦикла;

		// таблица без индексов (редко) — всё равно показать, если подходит по имени
		Если ТаблицаПодходит И СтрокаТаблицы.Индексы.Количество() = 0 Тогда
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Метаданные         = СтрокаТаблицы.Метаданные;
			НоваяСтрока.Назначение         = СтрокаТаблицы.Назначение;
			НоваяСтрока.ИмяТаблицыХранения = СтрокаТаблицы.ИмяТаблицыХранения;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Пример: все индексы одного регистра накопления (основная таблица, итоги, агрегаты).
//
// Объекты = Новый Массив;
// Объекты.Добавить(Метаданные.РегистрыНакопления.ТоварыНаСкладах);
// ТЗ = ПлоскаяСтруктураХранения("", Объекты);
